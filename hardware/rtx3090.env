# NVIDIA RTX 3090 (24 GB, Ampere sm_86). Billigste Miet-Option, knapp: Qwen3-30B-A3B Q4 ~19 GB.
# KV-Cache in q8_0, kleinerer Kontext, ein Modell pro GPU, ein Spiel pro Server.
HW_NAME="RTX 3090 (24 GB)"
CUDA_ARCH=86
VRAM_GB=24
MODELS_PER_GPU=1
GAMES_PER_SERVER=1
KV_TYPE=q8_0
CTX_PER_SLOT=20480
MIN_TOK_S=45          # erwartet ~110 tok/s (Einzelstrom); darunter: GPU-Offload vermutlich inaktiv
