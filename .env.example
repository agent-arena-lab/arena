# Copy to .env and adjust if needed (install.sh writes one automatically; pod.sh setzt alles selbst)
LLAMA_DIR=$HOME/llama.cpp
MODELS_DIR=$HOME/models
HF_HOME=$HOME/.cache/huggingface
