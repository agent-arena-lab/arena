# NVIDIA Jetson AGX Orin 64 GB (DLR, Unified Memory, sm_87). Entwicklung und Pilot, ~55 h für 200 Spiele.
HW_NAME="Jetson AGX Orin 64 GB"
CUDA_ARCH=87
VRAM_GB=64
MODELS_PER_GPU=1
GAMES_PER_SERVER=2
KV_TYPE=f16
CTX_PER_SLOT=24576
MIN_TOK_S=12          # erwartet ~30 tok/s (MAXN: sudo nvpmodel -m 0 && sudo jetson_clocks)
