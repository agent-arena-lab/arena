# NVIDIA H200 (141 GB, Hopper sm_90). Alle vier Kernmodelle auf einer GPU, je 2 Spiele parallel.
# (4 x ~19 GB + 4 x 4 Slots x ~2,4 GB ~ 115 GB). NVLink bringt nichts, jedes Modell passt auf eine GPU.
HW_NAME="H200 (141 GB)"
CUDA_ARCH=90
VRAM_GB=141
MODELS_PER_GPU=4
GAMES_PER_SERVER=2
KV_TYPE=f16
CTX_PER_SLOT=24576
MIN_TOK_S=100         # erwartet ~250 tok/s
