# Kern, mit Alignment: Qwen3-4B-Thinking-2507 (Q4_K_M, ~2.5 GB)
ALIAS=qwen3-4b-thinking
HF_REPO=unsloth/Qwen3-4B-Thinking-2507-GGUF
HF_INCLUDE="*Q4_K_M.gguf"
MODEL_GLOB="Qwen3-4B-Thinking-2507*Q4_K_M*.gguf"
# 32k max_tokens pro Antwort + Verlauf -> 64k Kontext (--parallel 1, Agenten rechnen nacheinander)
CTX=65536
# Qwen3-Thinking: <think>-Tags -> reasoning_content
EXTRA_ARGS="--reasoning-format deepseek"
