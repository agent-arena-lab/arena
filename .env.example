# Copy to .env and adjust if needed (install.sh writes one automatically)
LLAMA_DIR=$HOME/llama.cpp
MODELS_DIR=$HOME/models
HF_HOME=$HOME/.cache/huggingface
# HF_TOKEN=...            # für Gemma (Lizenz auf Hugging Face akzeptieren)
# llama.cpp fest pinnen (git-Tag, z. B. b7xxx) – wichtig für Reproduzierbarkeit und den Gemma-4-Budget-Bug
LLAMA_CPP_REF=master
# Harness: docker | native   llama-server: native | docker
HARNESS_MODE=docker
SERVER_MODE=native
# Modelle: self = Originalgewichte selbst quantisieren (saubere Paare) | prebuilt = fertige GGUFs
ARENA_QUANT=self
# Hardware-Profil erzwingen (sonst automatisch): rtx3090 | a6000 | rtxpro6000 | h100 | h200 | jetson | mac | generic
# ARENA_HARDWARE=h100
# Einzelwerte überschreiben (sonst aus hardware/<profil>.env)
# MODELS_PER_GPU=2
# GAMES_PER_SERVER=2
# KV_TYPE=q8_0
# CTX_PER_SLOT=24576
# Nur bestimmte GPUs nutzen
# CUDA_VISIBLE_DEVICES=0,1
