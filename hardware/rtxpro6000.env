# Einzige Zielhardware: NVIDIA RTX PRO 6000 Blackwell (96 GB, sm_120, CUDA >= 12.8), 1 GPU pro Pod.
# Lief im Podtest (Pod calm-hawk-da): Qwen ~270 tok/s, Gemma ~200 tok/s im Einzelstrom.
#
# Eine Familie pro Durchgang (Original + abliteriert = 2 Server auf derselben GPU), je 3 Spiele parallel
# (= 6 Slots pro Server). Speicher: 2 x ~19 GB Gewichte + 12 Slots x 36.864 Tokens x ~96 KB KV (Qwen, f16)
# ~ 38 + 42 ~ 80 GB. 24.576 Tokens pro Slot reichten im Podtest nicht (Gemma abliteriert lief über).
HW_NAME="RTX PRO 6000 Blackwell (96 GB)"
CUDA_ARCH=120
VRAM_GB=96
MODELS_PER_GPU=2
GAMES_PER_SERVER=3
KV_TYPE=f16
CTX_PER_SLOT=36864
MIN_TOK_S=100         # gemessen 200-270 tok/s im Einzelstrom
