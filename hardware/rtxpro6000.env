# NVIDIA RTX PRO 6000 Blackwell Max-Q (96 GB, sm_120, CUDA >= 12.8). Zwei Modelle pro GPU, je 3 Spiele parallel.
# (2 x ~19 GB Gewichte + 2 x 6 Slots x ~2,4 GB KV ~ 67 GB). Reduziertes Power-Limit kostet etwas Tempo.
HW_NAME="RTX PRO 6000 Blackwell Max-Q (96 GB)"
CUDA_ARCH=120
VRAM_GB=96
MODELS_PER_GPU=2
GAMES_PER_SERVER=3
KV_TYPE=f16
CTX_PER_SLOT=24576
MIN_TOK_S=70          # erwartet ~170 tok/s
